#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    float amount, totalSales = 0.0;

    // Step (i): Open the file for reading
    file = fopen("sales.txt", "r");
    if (file == NULL) {
        printf("Error: Could not open file 'sales.txt'.\n");
        return 1;
    }

    // Step (ii): Read all transactions and calculate total
    while (fscanf(file, "%f", &amount) == 1) {
        totalSales += amount;
    }

    // Step (iii): Close the file
    fclose(file);

    // Display the total sales
    printf("Total sales for the day: %.2f\n", totalSales);

    return 0;
}
