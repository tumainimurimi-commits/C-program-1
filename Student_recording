#include <stdio.h>
#include <stdlib.h>

// Step (i): Define a structure to hold student information
struct Student {
    char name[50];
    char regNo[20];
    float totalMarks;
};

int main() {
    FILE *file;
    struct Student student;

    // Step (ii): Open the binary file for reading
    file = fopen("results.dat", "rb");
    if (file == NULL) {
        printf("Error: Could not open file 'results.dat'.\n");
        return 1;
    }

    printf("Student Examination Results\n");
    printf("----------------------------\n");

    // Step (iii): Read and display each record
    while (fread(&student, sizeof(struct Student), 1, file) == 1) {
        printf("Name: %s\n", student.name);
        printf("Registration No: %s\n", student.regNo);
        printf("Total Marks: %.2f\n", student.totalMarks);
        printf("----------------------------\n");
    }

    fclose(file);
    return 0;
}
